  "keyFeatures": [
    "JSON-based querying with AST translation to Drizzle ORM SQL",
    "Koa-style onion middleware pipeline for extensible request interception",
    "Unified Role-Based Access Control (RBAC) with action-level and field-level enforcement",
    "Multi-dialect support for PostgreSQL, MySQL, and SQLite with dialect-specific strategies",
    "Native soft-delete capabilities with implicit safety filters",
    "Safe pagination using CTE Split Queries to prevent Cartesian fan-out",
    "Event-driven telemetry via mitt for non-blocking observability",
    "Quarkus-style pattern-based logging powered by pino",
    "End-to-end TypeScript type safety with inferred schema types and DeepPick projection"
  ],
  "publicApiSurface": [
    "createSchemaBuilder(db, tables, mode)",
    "SchemaBuilder.profiles(profiles)",
    "SchemaBuilder.policies(tableName, policyDefinition)",
    "SchemaBuilder.use(middleware, config)",
    "SchemaBuilder.table(tableName, config)",
    "SchemaBuilder.withLogger(config)",
    "SchemaBuilder.withTraceIdGenerator(gen)",
    "SchemaBuilder.on(event, handler)",
    "SchemaBuilder.build()",
    "CastorInstance.repoFactory(tableName)",
    "Repository.createOne(data, profile)",
    "Repository.createMany(data[], profile)",
    "Repository.searchOne(query, profile)",
    "Repository.searchMany(query, profile)",
    "Repository.searchPage(query, profile)",
    "Repository.searchDeletedOne(query, profile)",
    "Repository.searchDeletedMany(query, profile)",
    "Repository.searchDeletedPage(query, profile)",
    "Repository.updateOne(id, set, profile)",
    "Repository.updateMany(filter, set, profile)",
    "Repository.softDeleteOne(id, profile)",
    "Repository.softDeleteMany(filter, profile)",
    "Repository.restoreOne(id, profile)",
    "Repository.restoreMany(filter, profile)",
    "Repository.hardDeleteOne(id, profile)",
    "Repository.hardDeleteMany(filter, profile)",
    "Repository.defineFilter(filter)",
    "Repository.defineProjection(projection)",
    "Repository.defineQuery(query)",
    "Repository.defineUpdateSet(set)",
    "Repository.defineInsertValue(data)"
  ]
}
