{
  "projectType": "sdk-library",
  "projectName": "Drizzle Castor",
  "projectDescription": "A type-safe CRUD library and Data Access Object (DAO) abstraction over Drizzle ORM, providing JSON-based querying, a Koa-style middleware pipeline, unified RBAC, and multi-dialect support for PostgreSQL, MySQL, and SQLite.",
